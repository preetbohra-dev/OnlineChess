{
  "name": "online-chess",
  "version": "0.1.0",
  "private": true,
  "description": "Play, learn and train chess: local, online and against Stockfish personas, with a move-by-move coach.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "AUTH_ENV_FILE=/nonexistent/chess-auth.env node --test \"tests/{unit,server,content,engine}/**/*.test.js\"",
    "test:e2e": "playwright test --project=desktop && playwright test --project=mobile",
    "vendor": "node scripts/vendor.mjs",
    "postinstall": "node scripts/vendor.mjs",
    "puzzles": "node scripts/puzzles.mjs",
    "app:www": "node scripts/app-www.mjs",
    "app:sync": "node scripts/app-www.mjs && cap sync"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "cm-chessboard": "8.15.3",
    "web-push": "3.6.7",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/cli": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/share": "8.0.2",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@playwright/test": "1.56.1",
    "stockfish": "19.0.0"
  }
}
